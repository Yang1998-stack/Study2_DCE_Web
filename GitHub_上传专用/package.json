{
  "name": "study2-dce-web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit && node worker/scripts/check-design.mjs",
    "build": "tsc --noEmit && node worker/scripts/check-design.mjs && wrangler deploy --dry-run --outdir .worker-build",
    "test": "node --test --test-concurrency=1 worker/tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "ci": "node worker/scripts/ci.mjs",
    "recover:quickform": "node worker/scripts/quickform-to-long.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
